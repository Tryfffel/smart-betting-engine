# Anthropic API-nyckel för Claude Haiku (scoring) och Sonnet (enrich + LinkedIn-källan)
ANTHROPIC_API_KEY=sk-ant-...

# (Valfritt) Pek till en annan Indeed-staging-fil än /tmp/leadagent_indeed.json
# INDEED_JSON=/tmp/leadagent_indeed.json

# Google Drive – endast för schemalagda körningar (launchd). Manuella
# körningar via Claude Code kan fortfarande använda MCP enligt RUNBOOK.md.
# Skapa en service account i Google Cloud Console, ladda ner JSON-nyckeln,
# och dela mål-mappen med service-accountens email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=/absolut/sokvag/till/service-account.json
DRIVE_FOLDER_ID=
